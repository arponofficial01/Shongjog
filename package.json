{
  "name": "contact-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "com.shongjog.desktop",
    "productName": "Shongjog",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**/*",
      "electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/qrcode": "^1.5.6",
    "firebase": "^13.1.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  }
}
