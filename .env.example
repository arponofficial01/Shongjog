# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# TextBee (100% Free Real Telecom SMS via Android SIM - No Credit Card)
# 1. Sign up free at https://textbee.dev (No card required)
# 2. Install the TextBee Android app on a phone with your SIM card
# 3. Copy your API Key & Device ID below:
VITE_TEXTBEE_API_KEY=your-textbee-api-key
VITE_TEXTBEE_DEVICE_ID=your-device-id

# Firebase Phone Auth (Optional)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
